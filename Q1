/******************************************************************************
check if positive
check how many digits
*******************************************************************************/
#include <iostream>
using namespace std;

int main()
{
    int num;

    cout << "Enter a positive number: ";
    cin >> num;

    if (num <= 0) {
        cout << "This is a non-positive number";
    } else if (num > 9999) {
        cout << "This exceeds the maximum number of digits. "
             << "It should be only 4.";
    } else {
        cout << "This is a positive number\n";
        if (num < 10) {
            cout << "This is a 1 digit number.";
        } else if (num < 100) {
            cout << "This is a 2 digit number.";
        } else if (num < 1000) {
            cout << "This is a 3 digit number.";
        } else {
            cout << "This is a 4 digit number.";
        }
    }
    return 0;
}
